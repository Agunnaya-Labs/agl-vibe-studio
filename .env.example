# ==========================================
# AGUNNAYA LABS STUDIO - PRODUCTION CONFIG
# ==========================================

# Environment Mode
VITE_ENV=production

# ==========================================
# FIREBASE CONFIGURATION (Required)
# Get these from Firebase Console > Project Settings
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ==========================================
# GOOGLE AI (Gemini) - For AI Features
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# SECURITY & CORS
# ==========================================
VITE_CORS_ORIGINS=https://agunnaya.io,https://www.agunnaya.io

# ==========================================
# OPTIONAL: Error Reporting & Monitoring
# ==========================================
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# VITE_LOG_ROCKET_ID=your-logrocket-id

# ==========================================
# OPTIONAL: Analytics
# ==========================================
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000
APP_URL=https://agunnaya.io
