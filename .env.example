# ─────────────────────────────────────────────────────────────────────────────
# Agunnaya Labs Studio — Environment Secrets
# Copy this file and fill in real values. Never commit actual secrets to git.
# All values must be set in the Replit Secrets panel (Settings → Secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Google Gemini API key — powers all AI endpoints (contract builder, agent chat,
# image/video generation, email drafting, prompt optimiser, transcription).
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# JWT signing key for Telegram Mini App sessions (12-hour tokens).
# Also used as a general app session secret. Must be 32+ random characters.
# Generate one: openssl rand -hex 32
SESSION_SECRET="YOUR_SESSION_SECRET_MIN_32_CHARS"

# Telegram Bot token from @BotFather (/newbot or /mybots → copy token).
# Used for: HMAC validation of Telegram initData + /link bot command.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Firebase service account JSON (entire JSON object, single line).
# Required to enable Firebase Admin SDK — gives the server privileged Firestore
# write access, locks down tg_users/tg_nonces to server-only writes.
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Without this, the server falls back to the REST API (less secure).
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# The public URL of this app (used by the Telegram bot /link command to build
# the Mini App deep-link). Falls back to https://$REPLIT_DEV_DOMAIN if not set.
# Set this to your deployed URL after publishing.
# APP_URL="https://your-deployed-app.replit.app"

# Secret token to authenticate incoming Telegram webhook updates.
# Set the same value as `secret_token` when registering the webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>/api/miniapp/bot/webhook&secret_token=<THIS_VALUE>"
# Generate one: openssl rand -hex 16
# TELEGRAM_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
