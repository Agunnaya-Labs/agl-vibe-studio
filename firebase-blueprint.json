{
  "_metadata": {
    "version": "1.1.0",
    "schemaVersion": 1,
    "lastUpdated": "2026-07-16",
    "description": "AGL Vibe Studio Firebase Firestore schema and security configuration"
  },
  "entities": {
    "Token": {
      "title": "Token",
      "description": "Information about a bonding curve token",
      "type": "object",
      "properties": {
        "address": { "type": "string", "description": "Token contract address on Base" },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "description": { "type": "string" },
        "creator": { "type": "string", "description": "Wallet address of token creator" },
        "creatorFeesEarned": { "type": "number", "minimum": 0 },
        "currentPrice": { "type": "number", "minimum": 0 },
        "supply": { "type": "number", "minimum": 0 },
        "maxSupply": { "type": "number", "minimum": 0 },
        "marketCap": { "type": "number", "minimum": 0 },
        "reserveEth": { "type": "number", "minimum": 0 },
        "volume24h": { "type": "number", "minimum": 0 },
        "category": { "type": "string", "enum": ["meme", "defi", "ai", "utility", "gamefi"] },
        "logoUrl": { "type": "string", "format": "uri" },
        "isVerified": { "type": "boolean" },
        "vestingWeeks": { "type": "number", "minimum": 0 },
        "referralRewardsPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "type": "string", "enum": ["active", "archived", "deleted"], "default": "active" },
        "createdAt": { "type": "number", "description": "Unix timestamp" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["address", "name", "symbol", "creator", "currentPrice", "supply", "createdAt"],
      "indexes": [
        { "fields": ["category", "createdAt"], "order": ["asc", "desc"] },
        { "fields": ["marketCap"], "order": ["desc"] },
        { "fields": ["creator", "createdAt"], "order": ["asc", "desc"] }
      ]
    },
    "NFTCollection": {
      "title": "NFTCollection",
      "description": "Details about an NFT collection on Base",
      "type": "object",
      "properties": {
        "contractAddress": { "type": "string", "description": "NFT contract address" },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "description": { "type": "string" },
        "creator": { "type": "string", "description": "Wallet address of collection creator" },
        "mintPrice": { "type": "number", "minimum": 0 },
        "currentSupply": { "type": "number", "minimum": 0 },
        "maxSupply": { "type": "number", "minimum": 0 },
        "royaltyFee": { "type": "number", "minimum": 0, "maximum": 100 },
        "isRevealed": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "imageUrl": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["active", "archived", "deleted"], "default": "active" },
        "createdAt": { "type": "number", "description": "Unix timestamp" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["contractAddress", "name", "symbol", "creator", "mintPrice", "currentSupply", "maxSupply", "createdAt"],
      "indexes": [
        { "fields": ["creator", "createdAt"], "order": ["asc", "desc"] }
      ]
    },
    "DAO": {
      "title": "DAO",
      "description": "A decentralized autonomous organization",
      "type": "object",
      "properties": {
        "contractAddress": { "type": "string", "description": "DAO contract address" },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "description": { "type": "string" },
        "creator": { "type": "string", "description": "Wallet address of DAO creator" },
        "governanceTokenAddress": { "type": "string", "description": "References /tokens/{address}" },
        "treasuryBalanceEth": { "type": "number", "minimum": 0 },
        "memberCount": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["active", "archived", "deleted"], "default": "active" },
        "createdAt": { "type": "number", "description": "Unix timestamp" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["contractAddress", "name", "symbol", "creator", "governanceTokenAddress", "treasuryBalanceEth", "memberCount", "createdAt"],
      "indexes": [
        { "fields": ["creator", "createdAt"], "order": ["asc", "desc"] }
      ]
    },
    "GameFiProject": {
      "title": "GameFiProject",
      "description": "An interactive Web3 gaming and developer achievement system",
      "type": "object",
      "properties": {
        "contractAddress": { "type": "string", "description": "GameFi contract address" },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "description": { "type": "string" },
        "creator": { "type": "string", "description": "Wallet address of project creator" },
        "prizePoolEth": { "type": "number", "minimum": 0 },
        "activeSeasons": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["active", "archived", "deleted"], "default": "active" },
        "createdAt": { "type": "number", "description": "Unix timestamp" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["contractAddress", "name", "symbol", "creator", "prizePoolEth", "createdAt"],
      "indexes": [
        { "fields": ["creator", "createdAt"], "order": ["asc", "desc"] }
      ]
    },
    "AIAgent": {
      "title": "AIAgent",
      "description": "An autonomous intelligent agent offering core logic on Base",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "description": { "type": "string" },
        "contractAddress": { "type": "string" },
        "creator": { "type": "string", "description": "Wallet address of agent creator" },
        "tokenPrice": { "type": "number", "minimum": 0 },
        "usageFeeEth": { "type": "number", "minimum": 0 },
        "lifetimeRevenueEth": { "type": "number", "minimum": 0 },
        "queryCount": { "type": "number", "minimum": 0 },
        "systemPrompt": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "aglRewardDiscounts": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "archived", "deleted"], "default": "active" },
        "createdAt": { "type": "number", "description": "Unix timestamp" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["id", "name", "symbol", "creator", "usageFeeEth", "createdAt"],
      "indexes": [
        { "fields": ["creator", "createdAt"], "order": ["asc", "desc"] }
      ]
    },
    "StakingPool": {
      "title": "StakingPool",
      "description": "Details of staking pool yields",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tokenName": { "type": "string" },
        "tokenSymbol": { "type": "string" },
        "tokenAddress": { "type": "string", "description": "References /tokens/{address}" },
        "apr": { "type": "number", "minimum": 0, "maximum": 1000 },
        "tvlEth": { "type": "number", "minimum": 0 },
        "stakedBalance": { "type": "number", "minimum": 0 },
        "earnedRewards": { "type": "number", "minimum": 0 },
        "lockPeriodDays": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["active", "archived", "deleted"], "default": "active" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["id", "tokenName", "tokenSymbol", "tokenAddress", "apr", "tvlEth"],
      "indexes": [
        { "fields": ["apr"], "order": ["desc"] },
        { "fields": ["tvlEth"], "order": ["desc"] }
      ]
    },
    "Activity": {
      "title": "Activity",
      "description": "A ledger tracking active system events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["mint", "burn", "trade", "stake", "unstake", "claim", "transfer"] },
        "tokenSymbol": { "type": "string" },
        "tokenAddress": { "type": "string" },
        "user": { "type": "string", "description": "User wallet address" },
        "amount": { "type": "number", "minimum": 0 },
        "ethValue": { "type": "number", "minimum": 0 },
        "timestamp": { "type": "number", "description": "Unix timestamp" },
        "details": { "type": "string" }
      },
      "required": ["id", "type", "user", "timestamp", "details"],
      "indexes": [
        { "fields": ["user", "timestamp"], "order": ["asc", "desc"] },
        { "fields": ["type", "timestamp"], "order": ["asc", "desc"] }
      ]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Affiliate data linking referrers with fee calculations",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "ownerAddress": { "type": "string", "description": "Wallet address of referral code owner" },
        "totalReferredCount": { "type": "number", "minimum": 0 },
        "totalFeesGeneratedEth": { "type": "number", "minimum": 0 },
        "unclaimedRewardsAgl": { "type": "number", "minimum": 0 },
        "claimedRewardsAgl": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["active", "inactive", "deleted"], "default": "active" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["code", "ownerAddress", "totalReferredCount", "totalFeesGeneratedEth", "unclaimedRewardsAgl", "claimedRewardsAgl"]
    },
    "Session": {
      "title": "Session",
      "description": "Real-time backed developer session history for AI Builder state recovery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string" },
        "projectType": { "type": "string" },
        "aiResult": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "completed", "failed"], "default": "active" },
        "createdAt": { "type": "number", "description": "Unix timestamp" },
        "updatedAt": { "type": "number", "description": "Last modification timestamp" }
      },
      "required": ["id", "prompt", "projectType", "updatedAt"],
      "indexes": [
        { "fields": ["updatedAt"], "order": ["desc"] }
      ]
    }
  },
  "firestore": {
    "/tokens/{address}": {
      "schema": { "$ref": "#/entities/Token" },
      "description": "Database-backed registry for dynamic bonding curve tokens",
      "queryPatterns": ["category + createdAt", "marketCap DESC", "creator + createdAt"]
    },
    "/nfts/{contractAddress}": {
      "schema": { "$ref": "#/entities/NFTCollection" },
      "description": "Registry of on-chain minted non-fungible collections",
      "queryPatterns": ["creator + createdAt"]
    },
    "/daos/{contractAddress}": {
      "schema": { "$ref": "#/entities/DAO" },
      "description": "Guilds and DAOs with proposals on-chain",
      "queryPatterns": ["creator + createdAt"]
    },
    "/gamefi/{contractAddress}": {
      "schema": { "$ref": "#/entities/GameFiProject" },
      "description": "GameFi profiles detailing developer battles and quests",
      "queryPatterns": ["creator + createdAt"]
    },
    "/agents/{id}": {
      "schema": { "$ref": "#/entities/AIAgent" },
      "description": "Registry for AI Agent engines",
      "queryPatterns": ["creator + createdAt"]
    },
    "/staking/{id}": {
      "schema": { "$ref": "#/entities/StakingPool" },
      "description": "Active staking positions and TVL tracking",
      "queryPatterns": ["apr DESC", "tvlEth DESC"]
    },
    "/activities/{id}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Unified transaction ledger of actions taken inside the app",
      "queryPatterns": ["user + timestamp DESC", "type + timestamp DESC"]
    },
    "/referrals/{ownerAddress}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Active affiliate invite links"
    },
    "/sessions/{id}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Real-time backed developer session history for AI Builder state recovery",
      "queryPatterns": ["updatedAt DESC"]
    }
  },
  "security": {
    "rules": {
      "/tokens/{address}": {
        "read": "true",
        "write": "request.auth != null && request.auth.uid == resource.data.creator"
      },
      "/nfts/{contractAddress}": {
        "read": "true",
        "write": "request.auth != null && request.auth.uid == resource.data.creator"
      },
      "/daos/{contractAddress}": {
        "read": "true",
        "write": "request.auth != null && request.auth.uid == resource.data.creator"
      },
      "/gamefi/{contractAddress}": {
        "read": "true",
        "write": "request.auth != null && request.auth.uid == resource.data.creator"
      },
      "/agents/{id}": {
        "read": "true",
        "write": "request.auth != null && request.auth.uid == resource.data.creator"
      },
      "/staking/{id}": {
        "read": "true",
        "write": "request.auth != null"
      },
      "/activities/{id}": {
        "read": "request.auth != null",
        "write": "request.auth != null"
      },
      "/referrals/{ownerAddress}": {
        "read": "request.auth != null && request.auth.uid == ownerAddress",
        "write": "request.auth != null && request.auth.uid == ownerAddress"
      },
      "/sessions/{id}": {
        "read": "request.auth != null",
        "write": "request.auth != null"
      }
    }
  }
}
