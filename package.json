{
  "name": "agl-vibe-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Create, launch, manage, and scale fully custom on-chain applications, bonding curve tokens, DAOs, GameFi rewards, and autonomous AI agents.",
  "author": "David Okeamah <agunnaya001@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agunnaya001/agl-vibe-studio.git"
  },
  "bugs": {
    "url": "https://github.com/agunnaya001/agl-vibe-studio/issues"
  },
  "homepage": "https://github.com/agunnaya001/agl-vibe-studio#readme",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@9",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx server.ts",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "clean": "rimraf dist server.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.50.0",
    "prettier": "^2.8.8",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
