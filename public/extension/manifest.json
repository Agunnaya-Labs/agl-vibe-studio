{
  "manifest_version": 3,
  "name": "Agunnaya Labs Studio",
  "version": "1.0.0",
  "description": "AI-powered Web3 creation engine for smart contracts, tokens, DAOs, and more on Base mainnet",
  "author": "Agunnaya Labs",
  "homepage_url": "https://aistudio.agunnayalabs.xyz",
  "icons": {
    "16": "/images/brand/agunnaya-logo.png",
    "48": "/images/brand/agunnaya-logo.png",
    "128": "/images/brand/agunnaya-logo.png"
  },
  "action": {
    "default_title": "Agunnaya Labs Studio",
    "default_icon": {
      "16": "/images/brand/agunnaya-logo.png",
      "48": "/images/brand/agunnaya-logo.png",
      "128": "/images/brand/agunnaya-logo.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://api.agunnayalabs.xyz/*",
    "https://base.blockscout.com/*",
    "https://basescan.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js", "injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-studio": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Open Agunnaya Labs Studio"
    }
  },
  "action": {
    "default_popup": "popup.html"
  }
}
